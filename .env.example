# JS-Eyes 浏览器自动化服务
JS_EYES_WS_URL=ws://localhost:18080

# LLM API（AI 总结）
LLM_API_BASE_URL=
LLM_API_KEY=
LLM_API_MODEL=

# Flomo API
FLOMO_API_URL=

# 数据库路径（可选，默认 ./data/data.db）
# 本机作为正库时使用；客户端启用远程正库后不再当主库
DB_PATH=

# 本机作为正库时，保护 POST /api/v1/articles.json（必填才能远程写入）
API_TOKEN=

# 客户端：把局域网另一台 knowledge-collector 当正库
# 推荐对端跑 `node cli/cli.js serve`，前缀保持 /api/v1
REMOTE_DB_ENABLED=false
REMOTE_DB_BASE_URL=
REMOTE_DB_API_PREFIX=/api/v1
REMOTE_DB_TOKEN=
