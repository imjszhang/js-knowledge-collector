    "cheerio": "^1.1.2",
    "dotenv": "^16.4.7",
    "fetch-socks": "^1.3.3",
    "mammoth": "^1.12.0",
    "openai": "^6.26.0",
    "pdf-parse": "^2.4.5",
    "sqlite3": "^5.1.7",
    "undici": "^7.25.0",
    "ws": "^8.18.1"
  }
}
