  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "dev": "node cli/cli.js serve",
    "build": "node build/build.js",
    "preview": "npx serve docs -l 3000",
    "cli": "node cli/cli.js",
    "test": "node --test cli/lib/database.test.js cli/lib/db-config.test.js cli/lib/http-database.test.js cli/lib/server.test.js cli/lib/media/twimg.test.js"
  },
  "dependencies": {
